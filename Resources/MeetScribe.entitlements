<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- マイク録音 -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!--
      com.apple.security.get-task-allow は意図的に含めない。
      有効だと他プロセスからデバッガをアタッチでき、メモリ上のAPIキーや
      会議音声を読み取られうる。公証 (notarization) でも拒否される。
      ローカルでデバッガを使いたいときだけ一時的に付与すること。
    -->
</dict>
</plist>
